---
const { targetDate = new Date() } = Astro.props;
---

<!-- Wrap the component elements in our custom element “astro-heart”. -->
<event-countdown data-target-date={targetDate}>
  <div class="countdown-wrapper">
    <div class="countdown">
      <p class="countdown-value" id="countdown-month">0</p>
      <p class="countdown-label">Months</p>
    </div>
    <div class="countdown">
      <p class="countdown-value" id="countdown-day">0</p>
      <p class="countdown-label">Days</p>
    </div>
    <div class="countdown">
      <p class="countdown-value" id="countdown-hour">0</p>
      <p class="countdown-label">Hours</p>
    </div>
  </div>
</event-countdown>

<style>
  .countdown-wrapper {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: var(--px-32);
    margin-bottom: var(--px-24);
    margin-top: var(--px-24);
  }

  .countdown {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .countdown-value {
    font-size: clamp(var(--px-48), 10vw, var(--px-96));
    font-family: var(--font-allura);
    line-height: 1;
    color: var(--color-text-sage);
  }

  .countdown-label {
    font-size: clamp(var(--text-base), 1.5vw, var(--text-lg));
  }
</style>

<script>
  import countdown from "@utils/countdown";
  // Define the behavior for our new type of HTML element.
  class EventCountdown extends HTMLElement {
    intervalId: number | null = null;

    updateCountdown() {
      // Get the current countdown values based on the target date.
      console.log("Updating countdown...", this.dataset.targetDate);
      const current = countdown(
        new Date(),
        new Date(this.dataset.targetDate as string),
      );
      console.log("Current countdown values:", current);

      const { months, days, hours } = current;
      const countdownMonth = this.querySelector("#countdown-month");
      const countdownDay = this.querySelector("#countdown-day");
      const countdownHour = this.querySelector("#countdown-hour");

      if (countdownMonth) {
        countdownMonth.textContent = months?.toString() || "0";
      }
      if (countdownDay) {
        countdownDay.textContent = days?.toString() || "0";
      }
      if (countdownHour) {
        countdownHour.textContent = hours?.toString() || "0";
      }
    }

    connectedCallback() {
      // Update the countdown immediately when the element is added to the DOM.
      this.updateCountdown();
      // Set an interval to update the countdown every second.
      this.intervalId = window.setInterval(() => {
        this.updateCountdown();
      }, 10000);
    }

    disconnectedCallback() {
      // Clear the interval when the element is removed from the DOM.
      if (this.intervalId) {
        clearInterval(this.intervalId);
      }
    }
  }

  // Tell the browser to use our EventCountdown class for <event-countdown> elements.
  customElements.define("event-countdown", EventCountdown);
</script>
