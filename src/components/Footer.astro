---
import { SITE } from "@consts";

const currentYear = new Date().getFullYear();
---

<footer class="main-footer">
  <div class="footer footer-secondary">
    <div class="copyright">
      <p>&copy; {SITE.COMPANY_NAME} {currentYear}.</p>
    </div>
    <div class="location">
      <p>Based in Beverly Hills, California.</p>
    </div>
  </div>
</footer>

<style>
  a {
    transition: all var(--transition-short);
  }

  a:active {
    color: var(--color-text-primary);
  }

  .main-footer {
    background-color: var(--color-background);
    padding-block: var(--px-112) var(--px-28);
    padding-inline: var(--px-64);
    color: var(--color-text-dark);
    font-size: var(--text-sm);
  }

  .footer {
    display: flex;
    justify-content: space-between;
  }

  .headline {
    color: var(--color-text-primary);
  }

  .main-footer p {
    opacity: 1;
  }

  .footer-primary {
    margin-bottom: var(--px-112);
  }

  .logo {
    display: inline-block;
    margin-bottom: var(--px-28);
    font-size: var(--text-xl);
    font-weight: 700;
  }

  .site-description {
    margin-bottom: var(--px-32);
  }

  .footer-navigation {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    justify-content: space-between;
    width: 100%;
    margin-left: 16%;
    gap: var(--px-96);
  }

  .footer-heading {
    margin-bottom: var(--px-16);
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
    font-weight: 500;
    text-wrap: nowrap;
  }

  .footer-nav-list {
    display: inline-flex;
    flex-direction: column;
    font-size: var(--text-sm);
    gap: var(--px-8);
    text-wrap: nowrap;
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: var(--px-6);
  }

  .social-link :global(svg) {
    height: var(--px-18);
  }

  .contact-info {
    font-style: normal;
  }

  .footer-secondary {
    font-weight: 500;
  }

  @media (hover: hover) and (pointer: fine) {
    a:hover {
      color: var(--color-text-primary);
    }
  }

  @media screen and (max-width: 64rem) {
    .main-footer {
      padding-top: var(--px-80);
      padding-inline: var(--px-28);
    }

    .footer {
      flex-wrap: wrap;
      gap: var(--px-48);
    }

    .footer-navigation {
      margin-left: 0;
      width: auto;
    }

    .footer-primary {
      margin-bottom: var(--px-80);
    }
  }

  @media screen and (max-width: 37.5rem) {
    .main-footer {
      padding-top: var(--px-64);
    }

    .footer-navigation {
      grid-template-columns: 1fr;
      width: 100%;
      gap: var(--px-28);
    }

    .footer-secondary {
      gap: var(--px-6) var(--px-48);
    }

    .footer-primary {
      margin-bottom: var(--px-48);
    }
  }
</style>
