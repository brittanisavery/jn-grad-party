---
import { SITE } from "@consts";

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="copyright">
    <p>&copy; {SITE.COMPANY_NAME} {currentYear}.</p>
  </div>
  <div class="credit">
    <p>
      Created by <a
        href="https://brittanysavery.com"
        target="_blank"
        rel="noopener noreferrer"
        class="text-link"
      >
        Brittani S. Avery
      </a>
    </p>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--px-16) var(--px-28);
    background-color: var(--color-sage);
    color: var(--color-text-primary);
  }
</style>
