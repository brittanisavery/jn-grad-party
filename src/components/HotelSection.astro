---
import BaseSwiper from "./BaseSwiper.astro";
import { Image } from "astro:assets";
import hiltonOakLawn from "@assets/images/hilton-oak-lawn.jpg";
import sheratonRiverwalk from "@assets/images/sheraton-riverwalk.jpg";

const hotels = [
  {
    name: "Hilton Chicago/Oak Lawn",
    address: "9333 S Cicero Ave, Oak Lawn, IL 60453",
    directions: "https://maps.app.goo.gl/MWoGxaddbN6kQGQ5A",
    website:
      "https://www.hilton.com/en/hotels/chioahh-hilton-chicago-oak-lawn/",
    checkIn: "3:00 PM",
    checkOut: "11:00 AM",
    image: hiltonOakLawn,
    subtitle: "Stylish stay close to Midway Airport",
    description:
      "Conveniently located in Oak Lawn, the Hilton Chicago/Oak Lawn hotel is within five miles of Midway Airport, and offers a free airport shutt`le. Downtown is easily accessible via the Oak Lawn Metro, a half mile away. During your stay, enjoy South Side staples and cocktails at the restaurant. They also offer modern rooms, an indoor pool, a fitness center, versatile meeting space, and EV charging.",
  },
  {
    name: "Sheraton Grand Chicago Riverwalk",
    address: "301 E North Water St, Chicago, IL 60611",
    directions: "https://maps.app.goo.gl/U5wSndhXHmxHavVJ7",
    website: "https://www.sheraton.com/en/hotels/grand-chicago-riverwalk/",
    checkIn: "4:00 PM",
    checkOut: "12:00 PM",
    image: sheratonRiverwalk,
    subtitle: "Upscale hotel near Michigan Avenue",
    description:
      "Located close to Millennium Park and 875 North Michigan Avenue, Sheraton Grand Chicago Riverwalk provides a grocery/convenience store, a terrace, and a coffee shop/cafe. At the 3 on-site restaurants, enjoy breakfast, lunch, dinner, light fare, and American cuisine. Free WiFi in public areas is available to all guests, along with a garden and dry cleaning/laundry services.",
  },
];
---

<section id="where-to-stay" class="portfolio">
  <div class="section-container">
    <span class="section-tag">Where to Stay</span>
    <h2 class="section-title">Hotel Information</h2>
    <BaseSwiper sliderName="portfolio">
      {
        hotels.map((hotel) => (
          <div class="swiper-slide">
            <div class="project-image">
              <Image
                class="image after active"
                src={hotel.image}
                alt={hotel.name}
                width={1144}
                height={800}
                aria-hidden="false"
              />
            </div>
            <div class="project-info">
              <div class="info-section">
                <h3 class="section-subtitle info-title">{hotel.name}</h3>
                <p class="info-text">
                  <a
                    href={hotel.directions}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span class="text-link">{hotel.address}</span>&nbsp;
                    <span class="icon">open_in_new</span>
                  </a>
                  <br />
                  Check-in: {hotel.checkIn}
                  <br />
                  Check-out: {hotel.checkOut}
                </p>
              </div>
              <div class="info-section">
                <h3 class="section-subtitle info-title">{hotel.subtitle}</h3>
                <p class="info-text">{hotel.description}</p>
                <div>
                  <a
                    class="btn btn--primary"
                    href={hotel.website}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Book Now
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </BaseSwiper>
  </div>
</section>

<style>
  :global(.portfolio-swiper) {
    padding-inline: var(--px-64);
    position: relative;
  }

  .swiper-slide {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--px-64);
    opacity: 0;
    transform: scale(0.75);
    transition: all var(--transition-long);
  }

  .swiper-slide-active {
    opacity: 1;
    transform: scale(1);
  }

  .swiper-slide-prev,
  .swiper-slide-next {
    opacity: 0;
    transform: scale(0.75);
  }

  .section-text {
    font-size: clamp(var(--text-xl), 2vw, var(--text-2xl));
    line-height: 1.5;
    margin-bottom: var(--px-64);
  }

  .project-image {
    position: relative;
    min-height: 25rem;
    overflow: hidden;
  }

  .image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--transition-long);
  }

  .image.active {
    opacity: 1;
  }

  .project-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--px-32);
  }

  .info-section {
    display: flex;
    flex-direction: column;
    gap: var(--px-16);
  }

  .info-title {
    margin-bottom: 0;
  }

  .view-details {
    display: inline-flex;
    font-weight: 500;
    margin-top: auto;
  }

  .btn--secondary {
    border-bottom: var(--px-2) solid currentColor;
  }

  .btn--secondary-hovered {
    display: block;
  }

  @media screen and (max-width: 64rem) {
    .swiper-slide {
      gap: var(--px-32);
    }
  }

  @media screen and (max-width: 55rem) {
    :global(.portfolio-swiper) {
      padding-inline: 0;
    }

    .swiper-slide {
      grid-template-columns: 1fr;
      gap: var(--px-32);
    }

    .section-text {
      margin-bottom: var(--px-32);
    }
  }
</style>

<script>
  import { initSwiper } from "@utils/initSwiper";

  function initPortfolioSlider() {
    const portfolioSwiper = initSwiper("portfolio", {
      spaceBetween: 30,
      navigation: {
        nextEl: ".portfolio-next",
        prevEl: ".portfolio-prev",
      },
      pagination: {
        el: ".portfolio-pagination",
        type: "fraction",
        clickable: true,
      },
    });

    const updateSlideView = (view: string, slide: HTMLElement) => {
      const images = slide.querySelectorAll(".image");

      images.forEach((img) => {
        if (img.classList.contains(view)) {
          img.classList.add("active");
          img.setAttribute("aria-hidden", "false");
        } else {
          img.classList.remove("active");
          img.setAttribute("aria-hidden", "true");
        }
      });
    };

    document.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(
        ".toggle-btn",
      );
      if (!btn) return;

      document.querySelector(".toggle-btn.active")?.classList.remove("active");
      btn.classList.add("active");

      const view = btn.dataset.view;
      const currentSlide = portfolioSwiper.slides[portfolioSwiper.activeIndex];
      if (currentSlide && view) updateSlideView(view, currentSlide);
    });

    portfolioSwiper.on("slideChangeTransitionStart", () => {
      const activeSlide = portfolioSwiper.slides[portfolioSwiper.activeIndex];
      if (activeSlide) updateSlideView("after", activeSlide);

      document.querySelector(".toggle-btn.active")?.classList.remove("active");
      document
        .querySelector('.toggle-btn[data-view="after"]')
        ?.classList.add("active");
    });

    return () => {
      portfolioSwiper.destroy();
    };
  }

  let cleanup = initPortfolioSlider();

  document.addEventListener("astro:after-swap", () => {
    if (cleanup) cleanup();
    cleanup = initPortfolioSlider();
  });
</script>
