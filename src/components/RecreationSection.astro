---
const activities = [
  {
    name: "See The Bean (Cloud Gate) at Millennium Park",
    address: "201 E Randolph St, Chicago, IL 60602",
    directions: "",
    website:
      "https://www.chicago.gov/city/en/depts/dca/supp_info/millennium_park.html",
    description:
      "Cloud Gate is a large, stainless steel, bean-shaped sculpture in Millennium Park. Snap a photo of your group's reflection in The Bean with Chicago's skyscrapers in the background and the clouds floating above.",
  },
  {
    name: "Visit the Art Institute of Chicago",
    address: "111 S Michigan Ave, Chicago, IL 60603",
    directions: "",
    website: "https://www.artic.edu/",
    description:
      "The Art Institute of Chicago is one of the oldest and largest art museums in the United States. It houses a collection of over 300,000 works of art, including paintings, sculptures, prints, drawings, and decorative arts from around the world.",
  },
  {
    name: "Walk along the Chicago Riverwalk",
    address: "Chicago Riverwalk, Chicago, IL 60601",
    directions: "",
    website: "https://www.chicagoriverwalk.us/",
    description:
      "The Chicago Riverwalk is a pedestrian path along the south bank of the Chicago River. It features restaurants, bars, public art, and beautiful views of the city skyline.",
  },
  {
    name: "Explore Navy Pier",
    address: "600 E Grand Ave, Chicago, IL 60611",
    directions: "",
    website: "https://navypier.org/",
    description:
      "Navy Pier is a 3,300-foot-long pier on the Chicago shoreline of Lake Michigan. It features attractions such as the Centennial Wheel, Chicago Shakespeare Theater, and various restaurants and shops.",
  },
  {
    name: "Take an Architecture Boat Tour",
    address: "Chicago River, Chicago, IL 60601",
    directions: "",
    website: "https://www.architecture.org/tours/boat-tours/",
    description:
      "Chicago is known for its architecture, and one of the best ways to see it is from the water. Take a guided boat tour along the Chicago River to learn about the city's history and architecture.",
  },
];
---

<section id="things-to-do" class="recreation">
  <div class="section-container">
    <span class="section-tag">What to Do</span>
    <h2 class="section-title">Recreation Activities</h2>
    <div class="activities-container">
      {
        activities.map((activity) => (
          <div class="activity">
            <div class="activity-content">
              <h3 class="section-subtitle">{activity.name}</h3>
              <p>{activity.description}</p>
            </div>
            <p>
              <a
                class="learn-more"
                href={activity.website}
                target="_blank"
                rel="noopener noreferrer"
              >
                Learn More
              </a>
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
<style>
  .recreation {
    padding-block: var(--px-56) var(--px-64);
  }

  .activities-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(400px, 100%), 1fr));
    grid-auto-rows: minmax(150px, auto);
    gap: 10px;
    margin: 0 20px;
  }

  .activity {
    background-color: var(--color-sage);
    border-radius: 5px;
    margin-left: 5px;
    margin-right: 5px;
    margin-bottom: 10px;
    text-align: justify;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  @media (max-width: 400px) {
    .activity {
      text-align: left;
    }
  }

  .activity-content {
    padding: 20px;
  }

  .learn-more {
    display: block;
    text-align: center;
    padding: 10px;
    background-color: var(--color-light-golden);
    border: 1px solid var(--color-golden);
    border-radius: 0 0 5px 5px;
    color: var(--color-golden);
    text-decoration: none;
    text-transform: uppercase;
    font-weight: 600;
  }
</style>
