---
import { Image } from "astro:assets";
import boatImage from "@assets/images/boat.jpg";

const activities = [
  {
    name: "See The Bean (Cloud Gate) at Millennium Park",
    address: "201 E Randolph St, Chicago, IL 60602",
    directions: "",
    website:
      "https://www.chicago.gov/city/en/depts/dca/supp_info/millennium_park.html",
    description:
      "Cloud Gate is a large, stainless steel, bean-shaped sculpture in Millennium Park. Snap a photo of your group's reflection in The Bean with Chicago's skyscrapers in the background and the clouds floating above.",
  },
  {
    name: "Visit the Art Institute of Chicago",
    address: "111 S Michigan Ave, Chicago, IL 60603",
    directions: "",
    website: "https://www.artic.edu/",
    description:
      "The Art Institute of Chicago is one of the oldest and largest art museums in the United States. It houses a collection of over 300,000 works of art, including paintings, sculptures, prints, drawings, and decorative arts from around the world.",
  },
  {
    name: "Walk along the Chicago Riverwalk",
    address: "Chicago Riverwalk, Chicago, IL 60601",
    directions: "",
    website: "https://www.chicagoriverwalk.us/",
    description:
      "The Chicago Riverwalk is a pedestrian path along the south bank of the Chicago River. It features restaurants, bars, public art, and beautiful views of the city skyline.",
  },
  {
    name: "Explore Navy Pier",
    address: "600 E Grand Ave, Chicago, IL 60611",
    directions: "",
    website: "https://navypier.org/",
    description:
      "Navy Pier is a 3,300-foot-long pier on the Chicago shoreline of Lake Michigan. It features attractions such as the Centennial Wheel, Chicago Shakespeare Theater, and various restaurants and shops.",
  },
  {
    name: "Take an Architecture Boat Tour",
    address: "Chicago River, Chicago, IL 60601",
    directions: "",
    website: "https://www.architecture.org/tours/boat-tours/",
    description:
      "Chicago is known for its architecture, and one of the best ways to see it is from the water. Take a guided boat tour along the Chicago River to learn about the city's history and architecture.",
  },
];
---

<section id="things-to-do" class="recreation">
  <div class="section-container">
    <span class="section-tag">What to Do</span>
    <h2 class="section-title">Recreation Activities</h2>
    <div class="boat-container">
      <h3 class="section-subtitle">
        Chicago Signature Dinner Cruise on Lake Michigan
      </h3>
      <div class="boat-content">
        <Image
          src={boatImage}
          alt="A boat on the Chicago River with the city skyline in the background."
          width={600}
          height={400}
          class="boat-image"
        />
        <div class="boat-description">
          <p class="important-note">
            <b
              >Note: This event is an optional activity for the graduation party
              invitees.</b
            >
          </p>
          <p>
            Tickets are limited. To reserve, call <a href="tel:312-321-1241"
              ><span class="text-link">312-321-1241</span></a
            > and reserve under the following Booking ID: #87631497 and request general
            seating.
          </p>
          <p>
            Turn your dinner into an incredible night out with a delicious
            chef-curated buffet for all ages savored alongside the breathtaking
            backdrop of the city skyline. From the breezy open-air decks and
            comfortable indoor spaces, you’ll soak in spectacular views of
            Chicago’s iconic landmarks, such as Willis Tower and Navy Pier while
            our DJ spins today’s top hits. This unforgettable dining experience
            is complete with a fully stocked cash bar, games, and dancing into
            the night!
          </p>
          <p>
            Date: Friday, May 28th, 2027<br />
            Boarding Time: 6:30 PM<br />
            Time: 7:00 PM - 9:30 PM<br />
            Meetup Location: <a
              href="https://maps.google.com/?q=600+E+Grand+Ave,+Chicago,+IL+60611,+USA"
              target="_blank"
              rel="noopener noreferrer"
              ><span class="text-link"
                >600 E Grand Ave, Chicago, IL 60611, USA</span
              >&nbsp;<span class="icon">open_in_new</span></a
            ><br />
          </p>
        </div>
      </div>
      <a
        class="learn-more"
        href="https://tix.cityexperiences.com/j/hbchico/98dc1b63599f9e900a59a1e4091d70cc8b2518dfc5d0910a"
        target="_blank"
        rel="noopener noreferrer"
      >
        Learn More
      </a>
    </div>

    <div class="activities-container">
      {
        activities.map((activity) => (
          <div class="activity">
            <div class="activity-content">
              <h3 class="section-subtitle">{activity.name}</h3>
              <p>{activity.description}</p>
            </div>
            <p>
              <a
                class="learn-more"
                href={activity.website}
                target="_blank"
                rel="noopener noreferrer"
              >
                Learn More
              </a>
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
<style>
  .recreation {
    padding-block: var(--px-56) var(--px-64);
  }

  .boat-container {
    display: flex;
    flex-direction: column;
    /* gap: var(--px-20); */
    margin: 0 25px;
    margin-bottom: var(--px-40);
    h3 {
      margin-bottom: var(--px-20);
    }
  }
  .boat-content {
    display: flex;
    flex-direction: row;
    gap: var(--px-20);
  }
  .boat-description {
    p {
      margin-bottom: var(--px-20);
    }
  }

  .activities-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(400px, 100%), 1fr));
    grid-auto-rows: minmax(150px, auto);
    gap: 10px;
    margin: 0 20px;
  }

  .activity {
    background-color: var(--color-sage);
    border-radius: 5px;
    margin-left: 5px;
    margin-right: 5px;
    margin-bottom: 10px;
    text-align: justify;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  @media (max-width: 400px) {
    .activity {
      text-align: left;
    }
  }

  @media (max-width: 1024px) {
    .boat-content {
      flex-direction: column;
    }
  }

  .activity-content {
    padding: 20px;
  }

  .learn-more {
    display: block;
    text-align: center;
    padding: 10px;
    background-color: var(--color-light-golden);
    border: 1px solid var(--color-golden);
    border-radius: 0 0 5px 5px;
    color: var(--color-golden);
    text-decoration: none;
    text-transform: uppercase;
    font-weight: 600;
  }
</style>
