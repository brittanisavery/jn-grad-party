---
import { Image } from "astro:assets";
import EventCountdown from "./EventCountdown.astro";
import gradImage from "@assets/images/grad1-cropped.jpg";
import JustifiedGallery from "astro-gallery/components/JustifiedGallery.astro";
import Border from "@assets/images/border.svg";
---

<section id="hero" class="hero">
  <div class="section-container hero-container">
    <div class="hero-content">
      <p class="hero-caps">Chicago • Class of 2027</p>
      <h1 class="hero-title">Jeyda's Last Lap</h1>
      <p class="subtitle">The Grand Finale</p>
      <Border height={150} />
      <p>One last lap. One unforgettable night.</p>
      <p>Celebrating Jeyda • Sunday, May 30, 2027</p>
      <EventCountdown targetDate="2027-05-30T00:00:00Z" />
    </div>
    <div class="hero-content">
      <Image
        src={gradImage}
        alt="A picture of Jeyda, the graduate, smiling and holding her diploma."
        width={400}
        height={600}
        class="hero-image"
      />
    </div>
  </div>

  <style>
    .hero {
      display: flex;
      align-items: center;
    }
  </style>
</section>
