---
import EventCountdown from "./EventCountdown.astro";
---

<section id="hero" class="hero">
  <div class="section-container hero-container">
    <div class="hero-content">
      <h1 class="hero-title">Jeyda's Graduation Celebration</h1>
      <p class="hero-subtitle" style="font-style: italic;">Only</p>
      <EventCountdown targetDate="2027-05-30T00:00:00Z" />
      <p class="hero-subtitle">until the #NextChapter begins on May 30, 2027</p>
    </div>
    <div class="hero-content">
      <img
        src="https://placehold.co/400x600"
        alt="Jeyda's Graduation Celebration"
      />
    </div>
  </div>

  <style>
    .hero {
      min-height: 100vh;
      padding-block: 6.688rem var(--px-56);
      display: flex;
      align-items: center;
    }

    .hero-container {
      width: 100%;
      display: flex;
      flex-direction: row;
      gap: var(--px-64);
      align-items: center;
      text-align: center;
    }

    .hero-title {
      margin-bottom: var(--px-20);
      font-size: clamp(var(--text-4xl), 6vw, var(--text-6xl));
      font-family: var(--font-gideon-roman);
      line-height: 1.2;
      color: var(--color-text-sage);
    }

    .hero-subtitle {
      font-size: clamp(var(--text-xl), 2vw, var(--text-2xl));
      line-height: 1.5;
    }

    @media screen and (max-width: 64rem) {
      .hero-container {
        gap: var(--px-32);
      }

      .hero-content {
        max-width: 100%;
      }

      .hero-title {
        line-height: 1.3;
      }
    }

    @media screen and (max-width: 59.375rem) {
      .hero {
        min-height: auto;
      }

      .hero-container {
        flex-direction: column;
        gap: var(--px-32);
      }

      .hero-title {
        margin-bottom: var(--px-24);
      }

      .hero-cta {
        column-gap: var(--px-32);
      }

      .video-wrapper {
        min-height: 18.75rem;
      }
    }
  </style>
</section>
