---
import Border from "@assets/images/border.svg";
import gradImage from "@assets/images/grad1-cropped.jpg";
import EventCountdown from "./EventCountdown.astro";
import { Image } from "astro:assets";
---

<section id="hero" class="hero section-container">
  <div class="content">
    <p>&nbsp;</p>
    <h1 class="title">Jeyda's Last Lap</h1>
    <p class="subtitle">The Grad Finale: Class of 2027</p>
    <Border height={150} />
    <p>One last lap. One unforgettable night.</p>
    <p>Chicago • Sunday, May 30, 2027</p>
    <EventCountdown targetDate="2027-05-30T00:00:00Z" />
    <a
      class="btn btn--primary"
      href="https://forms.gle/5vaTo3md1RzEnfwT6"
      target="_blank"
      rel="noopener noreferrer"
    >
      Save your spot!
    </a>
  </div>
  <Image
    src={gradImage}
    alt="A picture of Jeyda, the graduate, smiling and holding her diploma."
    height={600}
    class="main"
  />
</section>

<style>
  .hero {
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--px-40);
  }

  .title {
    margin-bottom: var(--px-20);
    font-size: clamp(var(--text-4xl), 6vw, var(--text-6xl));
    font-family: var(--font-gideon-roman);
    line-height: 1.2;
    color: var(--color-text-sage);
  }
  .subtitle {
    text-transform: uppercase;
  }

  .main {
    border: 1px solid transparent;
    border-radius: 10px;
  }

  @media screen and (max-width: 59.375rem) {
    .hero {
      flex-direction: column;
      gap: var(--20-px);
    }

    .main {
      padding: var(--px-12) 0px;
      border-radius: 20px;
    }
  }
</style>
