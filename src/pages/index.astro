---
import FAQ from "@components/FAQ.astro";
import FoodSection from "@components/FoodSection.astro";
import HotelSection from "@components/HotelSection.astro";
import RecreationSection from "@components/RecreationSection.astro";
import WelcomeSection from "@components/WelcomeSection.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import ImageGallery from "astro-gallery/components/ImageGallery.astro";
---

<BaseLayout>
  <WelcomeSection />
  <section>
    <div class="section-container">
      <ImageGallery folderPath="gallery" />
    </div>
  </section>
  <HotelSection />
  <RecreationSection />
  <FoodSection />
  <FAQ />
</BaseLayout>
